# Neon Postgres connection string (with ?sslmode=require)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session secret for signing the JWT cookie (min 32 characters)
SESSION_SECRET=haziniy_super_secret_jwt_session_key_32_chars_min

# --- Media storage -----------------------------------------------------------
# Rasm va audio fayllar sukut bo'yicha ma'lumotlar bazasida saqlanadi
# (/api/media/<id>) — hech qanday qo'shimcha xizmat talab qilinmaydi.
# Quyidagi 3 ta qiymat TO'G'RI to'ldirilsa, fayllar avtomatik Cloudinary'ga
# yuklanadi; bo'sh yoki noto'g'ri bo'lsa, tizim bazaga saqlashga qaytadi.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial admin credentials for seeding
ADMIN_LOGIN=admin
ADMIN_PASSWORD=HaziniyAdmin2026!
